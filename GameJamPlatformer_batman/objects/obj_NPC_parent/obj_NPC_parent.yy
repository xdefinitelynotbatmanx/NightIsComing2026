    {"$GMObjectProperty":"v2","%Name":"dialogue_line_1","filters":[],"listItems":[],"multiselect":false,"name":"dialogue_line_1","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"Hello Stranger! I am the Guard.. who are you?","varType":2,},
    {"$GMObjectProperty":"v2","%Name":"dialogue_choice_1_1","filters":[],"listItems":[],"multiselect":false,"name":"dialogue_choice_1_1","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"... Hello I am Player One... where do I find the Wizard?","varType":2,},
    {"$GMObjectProperty":"v2","%Name":"dialogue_line_2","filters":[],"listItems":[],"multiselect":false,"name":"dialogue_line_2","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"Nice to meet you Player one! The Wizard is in his tower... north from the market. Be careful!","varType":2,},
    {"$GMObjectProperty":"v2","%Name":"dialogue_choice_1_2","filters":[],"listItems":[],"multiselect":false,"name":"dialogue_choice_1_2","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"I dont know... ","varType":2,},
    {"$GMObjectProperty":"v2","%Name":"dialogue_line_3","filters":[],"listItems":[],"multiselect":false,"name":"dialogue_line_3","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"...erm ok... thats a bit weird... go see the wizard for anti-forget potions.. he's North of the market...","varType":2,},
    {"$GMObjectProperty":"v2","%Name":"dialogue_choice_1_3","filters":[],"listItems":[],"multiselect":false,"name":"dialogue_choice_1_3","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"Who are you to ask me? lol","varType":2,},
